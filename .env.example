# ---------- Database (Neon) ----------
# Pooled connection string (host contains "-pooler"). Used at runtime.
DATABASE_URL=
# Direct (unpooled) connection string. Used only for migrations during the build.
# Vercel's Neon integration provides it as DATABASE_URL_UNPOOLED; either name works.
DIRECT_URL=

# ---------- API auth ----------
# 40+ random characters. Generate with: openssl rand -hex 32
API_KEY=
# Optional second key so you can rotate without downtime (see README).
API_KEY_ROTATION=

# ---------- Media (Vercel Blob) ----------
BLOB_READ_WRITE_TOKEN=

# ---------- Rate limiting (Upstash Redis) ----------
# Optional locally (falls back to in-memory). Required in production for a shared limit.
# Vercel's Upstash integration may name these KV_REST_API_URL / KV_REST_API_TOKEN; both are read.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Site ----------
# Public origin without trailing slash. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=http://localhost:3000
